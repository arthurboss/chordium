<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ replaces fullBackupContent with this file. Keep both so the
     same app data is backed up on old and new devices. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <include domain="file" path="." />
        <include domain="root" path="app_webview/Default/IndexedDB/" />
        <include domain="root" path="app_webview/Default/Local Storage/" />
        <include domain="root" path="app_webview/Default/Session Storage/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <include domain="file" path="." />
        <include domain="root" path="app_webview/Default/IndexedDB/" />
        <include domain="root" path="app_webview/Default/Local Storage/" />
        <include domain="root" path="app_webview/Default/Session Storage/" />
    </device-transfer>
</data-extraction-rules>
