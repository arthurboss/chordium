{
  "outputDirectory": "./dist",
  "framework": "vite",
  "functions": {
    "api/cifraclub-song.ts": {
      "maxDuration": 60
    },
    "api/artist-songs.ts": {
      "maxDuration": 60
    },
    "api/cifraclub-song-full.ts": {
      "maxDuration": 60
    },
    "api/link-preview.ts": {
      "maxDuration": 10,
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/:artist/:song",
      "has": [{ "type": "query", "key": "d" }],
      "destination": "/api/link-preview"
    },
    {
      "source": "/((?!api/|robots\\.txt|.*\\.css|.*\\.js|.*\\.br|.*\\.gz|sw\\.js|registerSW\\.js|workbox-.*\\.js|stats\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
